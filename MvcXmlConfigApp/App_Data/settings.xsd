<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://schemas.example.com/settings" xmlns="http://schemas.example.com/settings" elementFormDefault="qualified">
  <xs:element name="Settings">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ApplicationName" type="xs:string" />
        <xs:element name="EnableFeatureX" type="xs:boolean" />
        <xs:element name="MaxItems">
          <xs:simpleType>
            <xs:restriction base="xs:int">
              <xs:minInclusive value="1" />
              <xs:maxInclusive value="1000" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="Theme" type="xs:string" />
        <xs:element name="RefreshIntervalSeconds">
          <xs:simpleType>
            <xs:restriction base="xs:int">
              <xs:minInclusive value="5" />
              <xs:maxInclusive value="3600" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
