@model AppSettings
@{
    ViewData["Title"] = "Edit settings";
}

<h1 class="mb-4">Edit settings</h1>

<form asp-action="Edit" method="post" class="needs-validation" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="ApplicationName" class="form-label"></label>
        <input asp-for="ApplicationName" class="form-control" />
        <span asp-validation-for="ApplicationName" class="text-danger"></span>
    </div>

    <div class="form-check form-switch mb-3">
        <input asp-for="EnableFeatureX" class="form-check-input" />
        <label asp-for="EnableFeatureX" class="form-check-label"></label>
    </div>

    <div class="mb-3">
        <label asp-for="MaxItems" class="form-label"></label>
        <input asp-for="MaxItems" class="form-control" />
        <span asp-validation-for="MaxItems" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Theme" class="form-label"></label>
        <input asp-for="Theme" class="form-control" />
        <span asp-validation-for="Theme" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RefreshIntervalSeconds" class="form-label"></label>
        <input asp-for="RefreshIntervalSeconds" class="form-control" />
        <span asp-validation-for="RefreshIntervalSeconds" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
